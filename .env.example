TELEGRAM_BOT_TOKEN=PASTE_TOKEN_HERE
# Куда постить: ID чата/канала/группы. Для канала обычно вида -1001234567890
TELEGRAM_CHAT_ID=

# Источник постов: локальный Excel путь ИЛИ Google Sheets URL.
POSTS_XLSX_PATH=posts.xlsx
POSTS_SHEET_NAME=posts

# Для Google Sheets (один из двух вариантов):
# 1) путь к json-файлу service account (надёжнее; при использовании закомментируйте или очистите INLINE)
# Локально: sa.json в корне проекта. В Docker: /app/sa.json
GOOGLE_SERVICE_ACCOUNT_JSON=sa.json
# 2) или весь json ОДНОЙ СТРОКОЙ (без переносов внутри; в private_key только \n, не настоящие новые строки;
#    на этой же строке не ставьте #-комментарий — обрежет JSON). Проще ошибиться — тогда вариант (1).
# GOOGLE_SERVICE_ACCOUNT_JSON_INLINE={"type":"service_account",...}
GOOGLE_SERVICE_ACCOUNT_JSON_INLINE=

# Раз в сколько дней публиковать (по задаче: 2)
INTERVAL_DAYS=2

# Если true — отправит первый пост сразу после запуска, затем по расписанию
START_IMMEDIATELY=true

# Если true — скрипт сделает 0/1 публикацию и завершится (удобно для Планировщика задач Windows)
RUN_ONCE=false

# Прогресс (Postindex, LastPostedAt) только в листе State той же книги, что и Posts.

# Уровень логов в консоль: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Каталог для lock-файла и JSON-лога запусков (data/run_log.json)
DATA_DIR=data
RUN_LOG_PATH=data/run_log.json
BOT_LOCK_FILE=data/dekor_autoposting.lock

# Уведомления об упавших постах (личка Telegram)
TELEGRAM_ADMIN_CHAT_ID=253593784
# Сколько попыток перед пропуском поста
POST_MAX_ATTEMPTS=3
POST_RETRY_DELAY_SEC=3

# Пауза перед повтором цикла при сбое Google Sheets / сети (сек)
CYCLE_ERROR_BACKOFF_SEC=60

# Yandex Object Storage (автосинк медиа из таблицы в бакет)
YANDEX_ACCESS_KEY_ID=
YANDEX_SECRET_ACCESS_KEY=
YANDEX_BUCKET=dekorautoposting
# true — при каждом цикле бота синхронизировать Photo/Video с бакетом
YANDEX_AUTO_SYNC=true

# Автосжатие видео > лимита Telegram (МБ) перед заливкой в бакет
VIDEO_COMPRESS_ENABLED=true
TELEGRAM_MAX_VIDEO_MB=49
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
